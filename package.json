{
  "name": "browser-pdf-highlighter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json",
    "check:build": "tsx scripts/check-build.ts",
    "check:files": "tsx scripts/check-tracked-files.ts",
    "samples": "tsx scripts/generate-samples/main.ts",
    "samples:check": "tsx scripts/generate-samples/check.ts && tsx scripts/check-expected.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.1",
    "@fontsource/shippori-mincho-b1": "^5.3.0",
    "@tesseract.js-data/jpn": "^1.0.0",
    "diff": "^9.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
