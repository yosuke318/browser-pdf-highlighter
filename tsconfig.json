{
  // Node.js で動くコード(スクリプト・Vite の設定とプラグイン・ユニットテスト)
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts/**/*.ts",
    "vite-plugins/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "src/**/*.test.ts",
    "src/test-support/**/*.ts"
  ]
}
